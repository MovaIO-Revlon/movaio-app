      "tags": [
        "onedrive",
        "files",
        "folders",
        "update"
      ],
      "visibility": "public",
      "active": true,
      "protocol": "rest",
      "protocol_data": {
        "method": "PATCH",
        "path": "/v1.0/drive/items/{item_id}",
        "server_url": "https://graph.microsoft.com"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "description": "The unique identifier of the DriveItem."
          },
          "body": {
            "type": "object",
            "description": "The updated properties for the item.",
            "properties": {
              "name": {
                "type": "string",
                "description": "The new name of the file or folder."
              },
              "parentReference": {
                "type": "object",
                "description": "Target parent folder to move the item to.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The target parent folder ID."
