    {
      "name": "onedrive_create_folder",
      "description": "Creates a new folder inside a specified parent directory. Pass 'root' as parent_item_id to create in root.",
      "tags": [
        "onedrive",
        "folders"
      ],
      "visibility": "public",
      "active": true,
      "protocol": "rest",
      "protocol_data": {
        "method": "POST",
        "path": "/v1.0/drive/items/{parent_item_id}/children",
        "server_url": "https://graph.microsoft.com"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "parent_item_id": {
            "type": "string",
            "description": "The unique identifier of the parent folder DriveItem. Use 'root' for root directory."
          },
          "body": {
            "type": "object",
            "description": "Folder creation details",
            "properties": {
              "name": {
                "type": "string",
                "description": "The name of the new folder."
              },
              "folder": {
                "type": "object",
                "description": "An empty object to signify folder creation",
                "additionalProperties": true
              },
              "@microsoft.graph.conflictBehavior": {
                "type": "string",
                "description": "Behavior when folder exists: 'fail', 'replace', or 'rename'."
              }
            },
            "required": [
              "name",
              "folder"
            ],
            "additionalProperties": false
