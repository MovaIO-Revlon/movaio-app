      ],
      "visibility": "public",
      "active": true,
      "protocol": "rest",
      "protocol_data": {
        "method": "GET",
        "path": "/v1.0/drive/root/children",
        "server_url": "https://graph.microsoft.com"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "object",
            "description": "OData query parameters",
            "properties": {
              "$select": {
                "type": "string",
                "description": "Comma-separated list of properties to include in response (e.g., 'id,name,size,webUrl')."
              },
              "$expand": {
                "type": "string",
                "description": "Comma-separated list of relationships to expand."
              },
              "$top": {
                "type": "integer",
                "description": "The number of items to return in a result set."
              }
            },
            "required": [],
            "visible": [
