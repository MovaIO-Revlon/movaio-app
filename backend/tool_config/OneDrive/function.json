    {
      "name": "onedrive_upload_file",
      "description": "Uploads or replaces file content in OneDrive. If a target folder is specified, upload the file into that folder (create the folder first if it does not exist). If no folder is specified, upload the file directly to the root directory using 'root' as the parent_item_id.Also If user mention item id then call the list api and then fetch the item_id from them",
      "tags": [
        "onedrive",
        "files",
        "upload"
      ],
      "visibility": "public",
      "active": true,
      "protocol": "rest",
      "protocol_data": {
        "method": "PUT",
        "path": "/v1.0/drive/items/{parent_item_id}:/{filename}:/content",
        "server_url": "https://graph.microsoft.com"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "parent_item_id": {
            "type": "string",
            "description": "The parent folder ID. Use 'root' to upload directly into root folder."
          },
          "filename": {
            "type": "string",
            "description": "The target name of the file to be uploaded (including extension)."
          },
          "body": {
            "type": "string",
            "description": "The raw text or binary payload content of the file."
          }
        },
        "required": [
          "parent_item_id",
          "filename",
          "body"
        ],
        "visible": [
          "parent_item_id",
          "filename",
          "body"
        ],
        "additionalProperties": false
      }
    },
