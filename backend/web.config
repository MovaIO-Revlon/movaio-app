<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
  
  <httpErrors existingResponse="PassThrough" />
  
    <rewrite>
      <rules>
                <remove name="Angular Routes" />
                <remove name="api rule" />
        <rule name="ReverseProxyToFlask" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:5000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Enable Proxy via ARR -->
   <proxy enabled="true" preserveHostHeader="true" timeout="00:04:00" />
   
    <staticContent>
      <!-- <mimeMap fileExtension=".json" mimeType="application/json" /> -->
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <!-- Optional: Ensure index.html fallback for Angular routing -->
    <defaultDocument enabled="true">
      <files>
        <add value="index.html" />
      </files>
    </defaultDocument>
	
	<directoryBrowse enabled="false" />

    <!-- For IIS 10+ -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
	
  </system.webServer>
</configuration>
